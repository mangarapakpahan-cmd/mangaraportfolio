rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Publik dapat membaca portofolio; Admin terautentikasi dapat mengedit/menulis.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Form kontak: Pengunjung publik dapat mengirim pesan (create)
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}
